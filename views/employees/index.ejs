<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> — KaryawanApp</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<% const currentPath = '/employees'; %>
<%- include('../partials/sidebar') %>
<main class="main-content">
  <header class="topbar">
    <h1 class="page-title">Daftar Karyawan</h1>
  </header>
  <%- include('../partials/flash', { messages }) %>
  <div class="content-body">

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Total</div>
        <div class="stat-value"><%= stats.total %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Aktif</div>
        <div class="stat-value accent"><%= stats.activeCount %></div>
        <div class="stat-sub"><%= stats.activeRate %>%</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Rata-rata Gaji</div>
        <div class="stat-value" style="font-size:18px; padding-top:7px">
          <%= new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',minimumFractionDigits:0}).format(stats.avgSalary) %>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Departemen</div>
        <div class="stat-value accent2"><%= stats.departments.length %></div>
      </div>
    </div>

    <form method="GET" action="/employees">
      <div class="toolbar">
        <input
          type="text"
          name="search"
          class="search-input"
          placeholder="Cari nama, email, posisi..."
          value="<%= filters.search %>"
        />
        <select name="department" style="width:160px; padding:8px 12px; background:var(--surface2); border:1px solid var(--border); color:var(--text); font-family:var(--font-body); font-size:13px; outline:none;">
          <option value="">Semua Dept.</option>
          <% departments.forEach(d => { %>
            <option value="<%= d %>" <%= filters.department === d ? 'selected' : '' %>><%= d %></option>
          <% }) %>
        </select>
        <select name="status" style="width:140px; padding:8px 12px; background:var(--surface2); border:1px solid var(--border); color:var(--text); font-family:var(--font-body); font-size:13px; outline:none;">
          <option value="">Semua Status</option>
          <% statuses.forEach(s => { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn">Filter</button>
        <% if (filters.search || filters.department || filters.status) { %>
          <a href="/employees" class="btn">Reset</a>
        <% } %>
        <div class="toolbar-right">
          <a href="/employees/create" class="btn btn-primary">+ Tambah Karyawan</a>
        </div>
      </div>
    </form>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Nama</th>
            <th>Email</th>
            <th>Posisi</th>
            <th>Departemen</th>
            <th>Gaji</th>
            <th>Status</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (employees.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align:center; padding:40px; color:var(--text-muted)">
              Tidak ada data karyawan.
            </td>
          </tr>
          <% } %>
          <% employees.forEach((emp, i) => { %>
          <tr>
            <td style="color:var(--text-muted); font-size:12px"><%= i + 1 %></td>
            <td class="name-cell"><%= emp.name %></td>
            <td><%= emp.email %></td>
            <td><%= emp.position %></td>
            <td><%= emp.department %></td>
            <td>
              <%= new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',minimumFractionDigits:0}).format(emp.salary) %>
            </td>
            <td>
              <span class="badge badge-<%= emp.status %>">
                <%= emp.status === 'on_leave' ? 'Cuti' : emp.status === 'active' ? 'Aktif' : 'Nonaktif' %>
              </span>
            </td>
            <td>
              <div style="display:flex;gap:6px">
                <a href="/employees/<%= emp.id %>" class="btn btn-sm">Detail</a>
                <a href="/employees/<%= emp.id %>/edit" class="btn btn-sm">Edit</a>
                <form
                  action="/employees/<%= emp.id %>?_method=DELETE"
                  method="POST"
                  data-confirm="Hapus karyawan <%= emp.name %>?"
                >
                  <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>
</main>
<script src="/js/main.js"></script>
</body>
</html>
