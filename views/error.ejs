<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <title>Error — KaryawanApp</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@800&family=DM+Sans:wght@300&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<% const currentPath = ''; %>
<%- include('partials/sidebar') %>
<main class="main-content" style="display:flex;align-items:center;justify-content:center">
  <div style="text-align:center">
    <div style="font-family:var(--font-head);font-size:80px;font-weight:800;color:var(--danger);line-height:1;margin-bottom:16px">ERR</div>
    <div style="color:var(--text-muted);margin-bottom:8px">Terjadi kesalahan pada server.</div>
    <div style="color:var(--danger);font-size:12px;font-family:monospace;margin-bottom:24px"><%= error %></div>
    <a href="/" class="btn btn-primary">← Kembali ke Dashboard</a>
  </div>
</main>
</body>
</html>
